{
  "name": "wp-headless-kit",
  "version": "0.1.0",
  "description": "Typed, zero-dependency toolkit for building headless WordPress front ends: REST client, SEO metadata, and Gutenberg block rendering.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepare": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "wordpress",
    "headless",
    "nextjs",
    "gutenberg",
    "seo",
    "typescript"
  ],
  "author": "Numan Ul Haq (https://www.numanulhaq.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/numankhan4/wp-headless-kit.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
